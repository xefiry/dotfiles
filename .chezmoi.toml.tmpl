{{- if eq .chezmoi.hostname "home-pc" -}}
[diff]
command = "flatpak"
args = ["run", "org.gnome.meld", "--diff", "{{- "{{ .Destination }}" -}}", "{{- "{{ .Target }}" -}}"]

[merge]
command = "flatpak"
args = ["run", "org.gnome.meld", "--diff", "{{- "{{ .Destination }}" -}}", "{{- "{{ .Source }}" -}}", "{{- "{{ .Target }}" -}}"]
{{- else -}}
[cd]
command = "pwsh"
args = ["-NoLogo"]

[edit]
command = "code"
args = ["--wait"]

[diff]
command = "WinMergeU"
args = ["-s", "{{- "{{ .Destination }}" -}}", "{{- "{{ .Target }}" -}}"]

[merge]
command = "WinMergeU"
args = ["-s", "{{- "{{ .Destination }}" -}}", "{{- "{{ .Source }}" -}}", "{{- "{{ .Target }}" -}}"]
{{- end }}

[data]
fullName = "{{                 promptStringOnce . "fullName"                 "Full name "                  }}"
email = "{{                    promptStringOnce . "email"                    "e-mail "                     }}"
{{- if eq .chezmoi.hostname "home-pc" }}
Chatterino_username = "{{      promptStringOnce . "Chatterino_username"      "Chatterino - username "      }}"
Chatterino_userID = "{{        promptStringOnce . "Chatterino_userID"        "Chatterino - userID "        }}"
Chatterino_clientID = "{{      promptStringOnce . "Chatterino_clientID"      "Chatterino - clientID "      }}"
Chatterino_oauthToken = "{{    promptStringOnce . "Chatterino_oauthToken"    "Chatterino - oauthToken "    }}"
Chatterino_Notifications = '{{ promptStringOnce . "Chatterino_Notifications" "Chatterino - Notifications " }}'
{{- else }}
Espanso_emailTeam = "{{        promptStringOnce . "Espanso_emailTeam"        "Espanso - emailTeam "        }}"
Git_credential = "{{           promptStringOnce . "Git_credential"           "Git - credential "           }}"
LightBulb_Latitude = "{{       promptStringOnce . "LightBulb_Latitude"       "LightBulb - Latitude "       }}"
LightBulb_Longitude = "{{      promptStringOnce . "LightBulb_Longitude"      "LightBulb - Longitude "      }}"
{{- end }}
