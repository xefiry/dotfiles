{{ if eq .chezmoi.hostname "xefiry-pc" }}
Write-Host '
>>> rclone mount'
mount_OneDrive
{{ end }}

Write-Host '
>>> seek_and_destroy'
seek_and_destroy

Write-Host '
>>> chezmoi update'
chezmoi update 2> $null
if (!($?)) {
  Write-Error 'chezmoi update - error, run the command manually'
  Pause
}

{{ if eq .chezmoi.hostname "PS-0568" }}
Write-Host '
>>> sync_homedir'
sync_homedir

Write-Host '
>>> check_status'
check_status

Pause
{{ else }}
Start-Sleep -Seconds 5
{{ end -}}
