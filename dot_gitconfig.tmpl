[core]
{{ if eq .chezmoi.hostname "home-pc" -}}
editor = "flatpak run com.vscodium.codium --wait"
{{ else -}}
editor = "code --wait"
{{ end -}}
autocrlf = false

[push]
autoSetupRemote = true

[diff]
tool = winmerge

[user]
{{ if eq .chezmoi.hostname "home-pc" -}}
name = xefiry
email = 188508735+xefiry@users.noreply.github.com
{{ else -}}
name = {{ .fullName }}
email = {{ .email }}

[credential {{ .Git_credential | quote }}]
provider = generic
{{ end -}}
