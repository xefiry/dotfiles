# Unison preferences
batch = true
ignore = Name ?*
ignorenot = Name history.db
ignorenot = Name playlists.db
ignorenot = Name profiles.db
ignorenot = Name search-history.db
ignorenot = Name settings.db
label = Synchronize Freetube's db files to OneDrive
logfile = {{ env "Tmp" | replaceAllRegex "\\\\" "/" }}/unison_freetube.log
root = {{ env "AppData" | replaceAllRegex "\\\\" "/" }}/FreeTube
root = {{ env "OneDrive" | replaceAllRegex "\\\\" "/" }}/FreeTube
